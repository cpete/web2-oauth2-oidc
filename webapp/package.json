{
  "name": "workshop-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "OAuth2 confidential client: a server-side TypeScript web app that logs the user in with the Authorization Code Flow and keeps the tokens in a server-side session.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "openid-client": "^5.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
