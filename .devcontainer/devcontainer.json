{
  "name": "OAuth2 / OIDC workshop — webapp",
  "dockerComposeFile": [
    "../compose.yaml",
    "docker-compose.extend.yaml"
  ],
  "service": "webapp",
  "workspaceFolder": "/workspaces/web2-oauth2-oidc",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "forwardPorts": [3000, 3001, 8080],
  "postCreateCommand": "cd webapp && npm install",
  "shutdownAction": "stopCompose"
}
